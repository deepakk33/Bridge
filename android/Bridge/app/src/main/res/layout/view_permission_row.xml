<?xml version="1.0" encoding="utf-8"?>
<!-- One permission: whether it is held, what it is, what Bridge cannot do without it,
     and the single action that fixes it. BR-10 replaced a monospace dump of all of them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp">

    <View
        android:id="@+id/permission_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_state_pill" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/permission_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permission_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="12sp"
            android:alpha="0.7" />
    </LinearLayout>

    <Button
        android:id="@+id/permission_action"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="0dp" />
</LinearLayout>
